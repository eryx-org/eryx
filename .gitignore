# Build artifacts
/target

# Cargo lock is committed for reproducibility
# (don't ignore Cargo.lock)

# IDE/editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Rust-specific
**/*.rs.bk

# Plans directory (local planning docs)
/plans

# Environment files
.env
.env.local
.env.*.local

# Coverage reports
/coverage/
*.lcov

# Benchmarks output
/criterion/

# WebAssembly build artifacts
crates/eryx-runtime/runtime-python.wasm
crates/eryx-runtime/guest_bindings/
crates/eryx-runtime/__pycache__/

# Python virtual environments (componentize-py)
crates/eryx-runtime/.venv/

# Scratch directory for random experiments
/scratch
*.cwasm

# Pre-built runtime variants (generated by componentize-py)
runtime-*.wasm
crates/eryx-runtime/coreutils.wasm
crates/eryx-runtime/eryx-bundler.wasm
crates/eryx-bundler/target/

# WASI SDK (downloaded, not committed)
.wasi-sdk/

# eryx-guest-python build artifacts
crates/eryx-guest-python/target/
crates/eryx-guest-python/async_intrinsics.wasm
crates/eryx-guest-python/async_intrinsics.wat

# eryx-guest-python test artifacts (extracted from componentize-py)
crates/eryx-guest-python/tests/python-stdlib/
crates/eryx-guest-python/tests/site-packages/

# Decompressed library files (regenerated from .zst)
crates/eryx-runtime/libs/decompressed/

# cargo-rail backup files
.config/rail.toml.bak*

# eryx-python build artifacts
crates/eryx-python/.venv/
crates/eryx-python/python/eryx/__pycache__/
crates/eryx-python/python/eryx/_eryx*.so
crates/eryx-python/tests/__pycache__/
crates/eryx-python/.pytest_cache/
.beads/

# mdbook test artifacts
book/.test-examples/

# JavaScript bindings build artifacts (generated by jco transpile)
js/eryx/eryx-sandbox.js
js/eryx/eryx-sandbox.d.ts
js/eryx/eryx-sandbox.*.wasm
js/eryx/eryx-sandbox-*.js
js/eryx/eryx-sandbox-*.wasm
js/eryx/interfaces/
js/eryx/python-stdlib.tar.gz
js/eryx/node_modules/
js/testpkg/node_modules/

# Server custom runtime packages (populated by mise download-server-packages)
crates/eryx-server/packages/
crates/eryx-server/runtime-python.cwasm

# Demo example packages (populated at build time by mise copy-examples)
js/demo/public/examples/
