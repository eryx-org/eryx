{
  "name": "@bsull/eryx",
  "type": "module",
  "description": "A Python sandbox powered by WebAssembly, for browser and Node.js",
  "version": "0.12.1",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eryx-org/eryx.git",
    "directory": "js/eryx"
  },
  "files": [
    "interfaces/*",
    "shims/*",
    "*.wasm",
    "*.js",
    "*.d.ts",
    "python-stdlib.tar.gz",
    "README.md"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./callbacks": {
      "types": "./shims/callbacks.d.ts",
      "default": "./shims/callbacks.js"
    },
    "./shims/net": {
      "types": "./shims/net.d.ts",
      "default": "./shims/net.js"
    },
    "./shims/sockets": {
      "default": "./shims/sockets.js"
    },
    "./low-level": {
      "types": "./eryx-sandbox.d.ts",
      "default": "./eryx-sandbox.js"
    }
  },
  "imports": {
    "#preview2/cli": {
      "node": "./shims/preview2-node.js",
      "default": "@bytecodealliance/preview2-shim/cli"
    },
    "#preview2/clocks": {
      "node": "./shims/preview2-node.js",
      "default": "@bytecodealliance/preview2-shim/clocks"
    },
    "#preview2/filesystem": {
      "node": "./shims/preview2-node.js",
      "default": "@bytecodealliance/preview2-shim/filesystem"
    },
    "#preview2/io": {
      "node": "./shims/preview2-node.js",
      "default": "@bytecodealliance/preview2-shim/io"
    },
    "#preview2/random": {
      "node": "./shims/preview2-node.js",
      "default": "@bytecodealliance/preview2-shim/random"
    }
  },
  "keywords": [
    "python",
    "sandbox",
    "wasm",
    "webassembly",
    "component-model",
    "interpreter"
  ],
  "dependencies": {
    "@bytecodealliance/preview2-shim": "^0.31.0"
  }
}
